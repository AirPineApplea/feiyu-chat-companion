{
  "name": "feiyu-chat-companion",
  "version": "0.1.8",
  "description": "Desktop companion for DeepSeek Harness: a Win32 layered-window whale girl that sits above other windows, speaks in a bubble, and comments on its own when you stay on one window.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "overlay/pet_win32.py",
    "overlay/ask_box.py",
    "assets/open_rgba.png",
    "assets/closed_rgba.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "AirPineApplea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirPineApplea/feiyu-chat-companion.git"
  },
  "homepage": "https://github.com/AirPineApplea/feiyu-chat-companion#readme",
  "bugs": {
    "url": "https://github.com/AirPineApplea/feiyu-chat-companion/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "win32",
    "layered-window",
    "tts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
